# API Configuration
API_BASE_URL=http://localhost:8000
API_VERSION=v1
API_TIMEOUT=30

# Docker Configuration
DOCKER_CONTAINERS_TO_MONITOR=mongodb,postgres
DOCKER_LOG_LINES=100
DOCKER_HEALTH_CHECK_INTERVAL=300

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trademan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=trademan
MONGO_USER=mongodb
MONGO_PASSWORD=mongodb

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=logs/logmanager.log
LOG_RETENTION_DAYS=7

# Testing Configuration
TEST_TIMEOUT=30
TEST_RETRY_COUNT=3
TEST_RETRY_DELAY=5

# Endpoints to Test
ENDPOINTS_TO_TEST=[
    {"path": "/health", "method": "GET"},
    {"path": "/docs", "method": "GET"},
    {"path": "/api/v1/users", "method": "GET"},
    {"path": "/api/v1/users/me", "method": "GET"},
    {"path": "/api/v1/trades", "method": "GET"},
    {"path": "/api/v1/trades/active", "method": "GET"},
    {"path": "/api/v1/market/status", "method": "GET"},
    {"path": "/api/v1/market/instruments", "method": "GET"},
    {"path": "/api/v1/strategies", "method": "GET"},
    {"path": "/api/v1/strategies/active", "method": "GET"}
]

# Report Configuration
REPORT_PATH=reports
REPORT_FORMAT=detailed
REPORT_SAVE_HISTORY=true
